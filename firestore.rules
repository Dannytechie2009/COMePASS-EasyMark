rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- helpers --------
    function isSignedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function myRole() { return userDoc(myUid()).data.role; }
    function isAdmin() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'tutor' || myRole() == 'super_admin');
    }
    function isSuperAdmin() { return isSignedIn() && myRole() == 'super_admin'; }

    // -------- users --------
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == myUid() || isAdmin());
      allow create: if isSignedIn() && uid == myUid();
      allow update: if isSignedIn() && (
        (uid == myUid() && !( 'role' in request.resource.data.diff(resource.data).affectedKeys() ))
        || isAdmin()
      );
      allow delete: if isSuperAdmin() || (isSignedIn() && uid == myUid());

      match /readAnnouncements/{aid} {
        allow read, write: if isSignedIn() && uid == myUid();
      }
    }

    // -------- studentIds (uniqueness at registration) --------
    match /studentIds/{sid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == myUid();
      allow update, delete: if isAdmin();
    }

    // -------- syllabus (legacy path) --------
    match /syllabus/{doc=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------- topics (per-subject syllabus topics) --------
    match /topics/{tid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // -------- questions --------
    match /questions/{qid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------- exam sessions --------
    match /examSessions/{sid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /productKeys/{kid} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isSignedIn() && (
          isAdmin() ||
          (
            resource.data.used == false &&
            request.resource.data.used == true &&
            request.resource.data.usedBy == myUid()
          )
        );
      }

      match /violations/{vid} {
        allow read: if isAdmin();
        allow create: if isSignedIn() && request.resource.data.uid == myUid();
        allow update, delete: if isAdmin();
      }
    }

    // -------- attempts --------
    match /attempts/{aid} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.uid == myUid() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == myUid();
      allow update: if isSignedIn() && (
        (resource.data.uid == myUid() && resource.data.submitted == false)
        || isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == myUid());
    }

    // -------- announcements --------
    match /announcements/{aid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // -------- legal (privacy / terms versioned) --------
    match /legal/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------- feedback / contact --------
    match /feedback/{fid} {
      allow create: if isSignedIn() && request.resource.data.uid == myUid();
      allow read, update, delete: if isAdmin();
    }
  }
}
